{
    "recordViews": {
        "kanban": "custom:views/opportunity/record/kanban"
    },
    "dynamicLogic": {
        "fields": {
            "account": {
                "required": {
                    "conditionGroup": [
                        {
                            "type": "in",
                            "attribute": "stage",
                            "value": [
                                "interessentAngebotAngefordert",
                                "interessentAngebotInErstellung",
                                "kaeuferAngebotErhalten",
                                "kundeInDisposition",
                                "kundeLeistungserbringung",
                                "bestandskunde"
                            ]
                        }
                    ]
                }
            },
            "noGoGrund": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "qualifizierungsErgebnis",
                            "value": "noGo"
                        }
                    ]
                },
                "required": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "qualifizierungsErgebnis",
                            "value": "noGo"
                        }
                    ]
                }
            }
        }
    },
    "bottomPanels": {
        "detail": [
            {
                "name": "activities",
                "reference": "activities",
                "disabled": false,
                "view": "crm:views/opportunity/record/panels/activities",
                "createAttributeMap": {
                    "adresse": "adresse"
                }
            },
            {
                "name": "history",
                "reference": "history",
                "disabled": false
            }
        ]
    }
}
