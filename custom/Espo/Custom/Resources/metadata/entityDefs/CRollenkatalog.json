{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "rollencode": {
            "type": "varchar",
            "required": true,
            "unique": true,
            "maxLength": 6,
            "pattern": "^R-\\d{2}$",
            "tooltip": true
        },
        "aktiv": {
            "type": "bool",
            "required": true,
            "default": true,
            "tooltip": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "bereich": {
            "type": "enum",
            "options": [
                "",
                "geschaeftsfuehrung",
                "verkaufMarketing",
                "technikService",
                "backOffice",
                "itDigitalisierung",
                "stabsstelleQualitaet",
                "stabsstelleRecht"
            ],
            "isCustom": true,
            "tooltip": true
        },
        "uebergeordneteRolle": {
            "type": "link"
        },
        "uebergeordneteRolleRollencode": {
            "readOnly": true,
            "type": "foreign",
            "link": "uebergeordneteRolle",
            "field": "rollencode",
            "view": "views/fields/foreign-varchar",
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "cRollenzuordnungen": {
            "type": "hasMany",
            "foreign": "rolle",
            "entity": "CRollenzuordnung",
            "audited": false,
            "isCustom": true
        },
        "uebergeordneteRolle": {
            "type": "belongsTo",
            "foreign": "untergeordneteRollen",
            "entity": "CRollenkatalog",
            "audited": false,
            "isCustom": true
        },
        "untergeordneteRollen": {
            "type": "hasMany",
            "foreign": "uebergeordneteRolle",
            "entity": "CRollenkatalog",
            "audited": false,
            "isCustom": true
        },
        "cPruefregelnAlsUebersteuerungsRolle": {
            "type": "hasMany",
            "foreign": "uebersteuerungsRolle",
            "entity": "CPruefregel",
            "audited": false,
            "isCustom": true
        },
        "cPruefregelnAlsZustaendigeRolle": {
            "type": "hasMany",
            "foreign": "zustaendigeRolle",
            "entity": "CPruefregel",
            "audited": false,
            "isCustom": true
        },
        "cFreigabenAlsAnfordernbeRolle": {
            "type": "hasMany",
            "foreign": "anfordernbeRolle",
            "entity": "CFreigabe",
            "audited": false,
            "isCustom": true
        },
        "cFreigabenAlsErforderlicheRolle": {
            "type": "hasMany",
            "foreign": "erforderlicheRolle",
            "entity": "CFreigabe",
            "audited": false,
            "isCustom": true
        },
        "cFreigabeschwellen": {
            "type": "hasMany",
            "foreign": "erforderlicheRolle",
            "entity": "CFreigabeSchwelle",
            "audited": false,
            "isCustom": true
        },
        "prozesse": {
            "type": "hasMany",
            "foreign": "rolle",
            "entity": "CProzesshandbuch",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "rollencode": {
            "unique": true,
            "columns": [
                "rollencode",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}