{
    "fields": {
        "name": {
            "type": "varchar",
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "personalakte": {
            "type": "link"
        },
        "gueltigAb": {
            "type": "date",
            "required": true,
            "isCustom": true
        },
        "bruttogehalt": {
            "type": "float",
            "required": true,
            "isCustom": true
        },
        "stundenlohn": {
            "type": "float",
            "isCustom": true
        },
        "grundDerAenderung": {
            "type": "enum",
            "options": [
                "Neueinstellung",
                "Tariferhöhung",
                "Beförderung",
                "Nächstes Lehrjahr",
                "Leistungsanpassung",
                "Sonstige"
            ],
            "isCustom": true
        },
        "bemerkung": {
            "type": "text",
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "personalakte": {
            "type": "belongsTo",
            "foreign": "personalakteGehalts",
            "entity": "CPersonalakte",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "gueltigAb",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}