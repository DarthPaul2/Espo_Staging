        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "UNIQ_ZIEL": {
            "unique": true,
            "columns": [
                "zielEntitaet",
                "zielId",
                "deleted"
            ]
        },
        "projekt": {
            "columns": [
                "projektId",
                "deleted"
            ]
        },
        "rechnung": {
