{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "bezugEntitaet": {
            "type": "varchar",
            "maxLength": 50,
            "required": true,
            "isCustom": true,
            "tooltip": true
        },
        "bezugId": {
            "type": "varchar",
            "maxLength": 24,
            "required": true,
            "isCustom": true,
            "tooltip": true
        },
        "qualifikation": {
            "type": "link",
            "required": true,
            "isCustom": true,
            "tooltip": true
        },
        "anforderungsTyp": {
            "type": "enum",
            "options": ["MUST", "EXTERNAL_MUST", "SHOULD"],
            "required": true,
            "isCustom": true,
            "tooltip": true,
            "style": {"MUST": "danger", "EXTERNAL_MUST": "danger", "SHOULD": "warning"}
        },
        "beschreibung": {
            "type": "text",
            "isCustom": true,
            "tooltip": true
        },
        "projekt": {
            "type": "link",
            "required": false,
            "readOnly": true,
            "isCustom": true,
            "tooltip": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "qualifikation": {
            "type": "belongsTo",
            "entity": "CQualifikation",
            "foreign": "cQualifikationsanforderungen",
            "isCustom": true
        },
        "projekt": {
            "type": "belongsTo",
            "entity": "CProjekt",
            "foreign": "qualifikationsanforderungen",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "bezug": {
            "columns": [
                "bezugEntitaet",
                "bezugId",
                "deleted"
            ]
        },
        "projekt": {
            "columns": [
                "projektId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}