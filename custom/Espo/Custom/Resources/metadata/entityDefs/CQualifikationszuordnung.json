{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "mitarbeiter": {
            "type": "link",
            "required": true,
            "isCustom": true,
            "tooltip": true
        },
        "qualifikation": {
            "type": "link",
            "required": true,
            "isCustom": true,
            "tooltip": true
        },
        "gueltigVon": {
            "type": "date",
            "required": true,
            "isCustom": true,
            "tooltip": true
        },
        "gueltigBis": {
            "type": "date",
            "isCustom": true,
            "tooltip": true
        },
        "nachweisDokument": {
            "type": "file",
            "sourceList": [],
            "accept": [],
            "isCustom": true,
            "tooltip": true
        },
        "eigenerStatus": {
            "type": "enum",
            "options": ["", "GUELTIG", "LAEUFT_BALD_AB", "ABGELAUFEN"],
            "readOnly": true,
            "isCustom": true,
            "tooltip": true,
            "style": {"GUELTIG": "success", "LAEUFT_BALD_AB": "warning", "ABGELAUFEN": "danger"}
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "mitarbeiter": {
            "type": "belongsTo",
            "entity": "User",
            "foreign": "cQualifikationszuordnungen",
            "isCustom": true
        },
        "qualifikation": {
            "type": "belongsTo",
            "entity": "CQualifikation",
            "foreign": "cQualifikationszuordnungen",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "mitarbeiter": {
            "columns": [
                "mitarbeiterId",
                "deleted"
            ]
        },
        "qualifikation": {
            "columns": [
                "qualifikationId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}