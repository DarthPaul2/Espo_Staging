{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "avisNummer": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "readOnly": true,
            "isCustom": true
        },
        "datum": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "lieferant": {
            "type": "link"
        },
        "bankkonto": {
            "type": "link"
        },
        "betragGesamt": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "pdfUrl": {
            "type": "url",
            "view": "custom:views/c-zahlungsavis/fields/pdf-url",
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "lieferant": {
            "type": "belongsTo",
            "foreign": "zahlungsavise",
            "entity": "CLieferant",
            "audited": false,
            "isCustom": true
        },
        "bankkonto": {
            "type": "belongsTo",
            "foreign": "zahlungsavise",
            "entity": "CBankkonto",
            "audited": false,
            "isCustom": true
        },
        "zahlungsavisPosition": {
            "type": "hasMany",
            "foreign": "zahlungsavis",
            "entity": "CZahlungsavisPosition",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}