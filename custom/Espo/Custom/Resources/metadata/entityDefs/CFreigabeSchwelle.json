{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "vorgangsart": {
            "type": "enum",
            "options": ["Einkauf", "Angebot", "Kulanz", "Rechnung", "Vertrag", "Change", "Materialsubstitution"],
            "required": true,
            "isCustom": true,
            "tooltip": true
        },
        "projektbezogen": {
            "type": "enum",
            "options": ["", "ja", "nein"],
            "isCustom": true,
            "tooltip": true
        },
        "betragVon": {
            "type": "float",
            "isCustom": true,
            "tooltip": true
        },
        "betragBis": {
            "type": "float",
            "isCustom": true,
            "tooltip": true
        },
        "erforderlicheRolle": {
            "type": "link",
            "isCustom": true,
            "tooltip": true
        },
        "erforderlicheRolleRollencode": {
            "readOnly": true,
            "type": "foreign",
            "link": "erforderlicheRolle",
            "field": "rollencode",
            "view": "views/fields/foreign-varchar",
            "isCustom": true
        },
        "beschreibung": {
            "type": "text",
            "isCustom": true,
            "tooltip": true
        },
        "aktiv": {
            "type": "bool",
            "default": true,
            "isCustom": true,
            "tooltip": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "erforderlicheRolle": {
            "type": "belongsTo",
            "entity": "CRollenkatalog",
            "foreign": "cFreigabeschwellen",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "vorgangsart": {
            "columns": [
                "vorgangsart",
                "aktiv",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}