{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "beschreibung": {
            "type": "text",
            "isCustom": true
        },
        "prozessStatus": {
            "type": "enum",
            "options": [
                "vorgeschlagen",
                "inBearbeitung",
                "fertig"
            ],
            "style": {
                "vorgeschlagen": "warning",
                "inBearbeitung": "info",
                "fertig": "success"
            },
            "default": "vorgeschlagen",
            "maxLength": 100,
            "isCustom": true
        },
        "bereich": {
            "type": "enum",
            "options": [
                "",
                "01_GES_Geschäftsführung",
                "02_MIT_Mitarbeiter",
                "03_MRK_Marke",
                "04_FIN_Finanzen",
                "05_KUG_Kundengewinnung",
                "06_LEB_Leistungserbringung",
                "07_ADM_Administration",
                "08_INF_Infrastruktur",
                "09_QLT_Qualität"
            ],
            "notNull": false,
            "tooltip": true,
            "isCustom": true
        },
        "ticket": {
            "type": "link",
            "isCustom": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        }
    },
    "links": {
        "ticket": {
            "type": "belongsTo",
            "entity": "CTicket"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    },
    "optimisticConcurrencyControl": false,
    "transactionalSave": false
}