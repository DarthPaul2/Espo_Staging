{
    "hooks": {
        "beforeSave": [
            "AutoNumber",
            "PreventEditIfFestgeschrieben",
            "SetEingangsdatumIfEmpty"
        ],
        "beforeRemove": [
            "PreventDeleteIfFestgeschrieben"
        ]
    },
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "pattern": "$noBadCharacters",
            "options": []
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "eingangsrechnungsnummer": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true,
            "readOnly": true
        },
        "lieferantenRechnungsnummer": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "belegdatum": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "eingangsdatum": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "faelligAm": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "betragBrutto": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "betragNetto": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "steuerBetrag": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "steuerfall": {
            "type": "enum",
            "options": [
                "ust19",
                "ust7",
                "steuerfrei"
            ],
            "style": {
                "ust19": null,
                "ust7": null,
                "steuerfrei": null
            },
            "default": "ust19",
            "maxLength": 100,
            "isCustom": true
        },
        "status": {
            "type": "enum",
            "options": [
                "entwurf",
                "freigabe",
                "festgeschrieben"
            ],
            "style": {
                "entwurf": null,
                "freigabe": null,
                "festgeschrieben": null
            },
            "default": "entwurf",
            "maxLength": 100,
            "isCustom": true
        },
        "festgeschriebenAm": {
            "notNull": false,
            "type": "datetime",
            "minuteStep": 30,
            "isCustom": true
        },
        "aktiv": {
            "notNull": true,
            "type": "bool",
            "default": true,
            "isCustom": true
        },
        "bemerkung": {
            "type": "text",
            "rowsMin": 2,
            "cutHeight": 200,
            "isCustom": true
        },
        "pruefhinweis": {
            "type": "text",
            "rowsMin": 2,
            "cutHeight": 200,
            "isCustom": true
        },
        "lieferant": {
            "type": "link"
        },
        "buchungsjournal": {
            "type": "link"
        },
        "festgeschriebenVon": {
            "type": "link"
        },
        "freigabeAm": {
            "notNull": false,
            "type": "datetime",
            "minuteStep": 30,
            "isCustom": true
        },
        "zahlungsstatus": {
            "type": "enum",
            "options": [
                "offen",
                "teilweise_bezahlt",
                "bezahlt",
                "storniert"
            ],
            "style": {
                "offen": "primary",
                "teilweise_bezahlt": "info",
                "bezahlt": "success",
                "storniert": "danger"
            },
            "default": "offen",
            "maxLength": 100,
            "isCustom": true,
            "displayAsLabel": true
        },
        "restbetragOffen": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "istStorniert": {
            "notNull": true,
            "type": "bool",
            "readOnly": true,
            "isCustom": true
        },
        "storniertAm": {
            "notNull": false,
            "type": "datetime",
            "minuteStep": 30,
            "isCustom": true
        },
        "stornoGrund": {
            "type": "text",
            "rowsMin": 2,
            "cutHeight": 200,
            "isCustom": true
        },
        "storniertVon": {
            "type": "link"
        },
        "istKorrekturbeleg": {
            "notNull": true,
            "type": "bool",
            "readOnly": true,
            "default": false,
            "isCustom": true
        },
        "korrekturTyp": {
            "type": "enum",
            "options": [
                "inhaltliche_korrektur",
                "betragskorrektur",
                "positionskorrektur",
                "steuerkorrektur",
                "adresskorrektur",
                "formelle_korrektur",
                "sonstige_korrektur",
                "keine_korrektur"
            ],
            "style": {
                "inhaltliche_korrektur": null,
                "betragskorrektur": null,
                "positionskorrektur": null,
                "steuerkorrektur": null,
                "adresskorrektur": null,
                "formelle_korrektur": null,
                "sonstige_korrektur": null,
                "keine_korrektur": null
            },
            "maxLength": 100,
            "isCustom": true,
            "default": "keine_korrektur"
        },
        "korrekturGrund": {
            "type": "text",
            "rowsMin": 2,
            "cutHeight": 200,
            "isCustom": true
        },
        "ersetztBelegId": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true,
            "options": [],
            "tooltip": true,
            "isCustom": true
        },
        "nachfolgeBelegId": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true,
            "options": [],
            "tooltip": true,
            "isCustom": true
        },
        "nachfolgeBelegName": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true,
            "options": [],
            "isCustom": true
        },
        "ersetztBelegName": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true,
            "options": [],
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "lieferant": {
            "type": "belongsTo",
            "foreign": "eingangsrechnungen",
            "entity": "CLieferant",
            "audited": false,
            "isCustom": true
        },
        "buchungsjournal": {
            "type": "belongsTo",
            "foreign": "eingangsrechnungs",
            "entity": "CBuchungsjournal",
            "audited": false,
            "isCustom": true
        },
        "festgeschriebenVon": {
            "type": "belongsTo",
            "foreign": "cEingangsrechnungs",
            "entity": "User",
            "audited": false,
            "isCustom": true
        },
        "eingangsrechnungspositionen": {
            "type": "hasMany",
            "foreign": "eingangsrechnung",
            "entity": "CEingangsrechnungsposition",
            "audited": false,
            "isCustom": true
        },
        "importe": {
            "type": "hasMany",
            "foreign": "eingangsrechnung",
            "entity": "CEingangsrechnungImport",
            "audited": false,
            "isCustom": true
        },
        "ausgleiche": {
            "type": "hasMany",
            "foreign": "eingangsrechnung",
            "entity": "CAusgleich",
            "audited": false,
            "isCustom": true
        },
        "storniertVon": {
            "type": "belongsTo",
            "foreign": "cStornierteEingangsrechnungen",
            "entity": "User",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}