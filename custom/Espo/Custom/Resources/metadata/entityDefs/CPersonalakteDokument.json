{
    "fields": {
        "name": {
            "type": "varchar",
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "personalakte": {
            "type": "link",
            "required": true
        },
        "dokumentart": {
            "type": "enum",
            "options": [
                "Arbeitsvertrag",
                "Änderungsvertrag",
                "Gehaltsvereinbarung",
                "Gehaltsänderung",
                "Lohn-/Gehaltsabrechnung",
                "Stundenzettel",
                "Bewerbung",
                "Lebenslauf",
                "Zeugnisse",
                "Qualifikationen",
                "Führerschein",
                "Unterweisungen",
                "Dienstanweisungen",
                "Datenschutzerklärungen",
                "Verschwiegenheitserklärungen",
                "Krankmeldung / AU",
                "Mitarbeitergespräche",
                "Abmahnungen",
                "Weiterbildungen",
                "Zertifikate",
                "Übergabeprotokolle",
                "Firmenfahrzeug",
                "Werkzeug",
                "Firmenhandy / IT",
                "Kündigung",
                "Arbeitszeugnis",
                "sonstige Personalunterlagen"
            ],
            "required": true,
            "isCustom": true
        },
        "dokumentdatum": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "gueltigAb": {
            "type": "date",
            "isCustom": true
        },
        "gueltigBis": {
            "type": "date",
            "isCustom": true
        },
        "bemerkung": {
            "type": "text",
            "isCustom": true
        },
        "datei": {
            "type": "file",
            "sourceList": [],
            "accept": [],
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "personalakte": {
            "type": "belongsTo",
            "foreign": "personalakteDokuments",
            "entity": "CPersonalakte",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}