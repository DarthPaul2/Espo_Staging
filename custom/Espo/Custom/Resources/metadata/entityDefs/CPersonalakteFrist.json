{
    "fields": {
        "name": {
            "type": "varchar",
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "personalakte": {
            "type": "link",
            "required": true
        },
        "art": {
            "type": "enum",
            "options": [
                "Probezeitende",
                "Befristeter Vertrag Ende",
                "Führerscheinkontrolle",
                "Zertifikat läuft aus",
                "Unterweisung fällig",
                "Mitarbeitergespräch",
                "Berechtigung/Nachweis läuft aus",
                "Sonstiges"
            ],
            "required": true,
            "isCustom": true
        },
        "faelligAm": {
            "type": "date",
            "required": true,
            "isCustom": true
        },
        "status": {
            "type": "enum",
            "options": [
                "offen",
                "erledigt"
            ],
            "style": {
                "offen": "warning",
                "erledigt": "success"
            },
            "default": "offen",
            "isCustom": true
        },
        "bemerkung": {
            "type": "text",
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "personalakte": {
            "type": "belongsTo",
            "foreign": "personalakteFrists",
            "entity": "CPersonalakte",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}