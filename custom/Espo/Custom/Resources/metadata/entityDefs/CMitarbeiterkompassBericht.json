{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "jahr": {
            "type": "int",
            "isCustom": true
        },
        "halbjahr": {
            "type": "enum",
            "options": [
                "H1",
                "H2"
            ],
            "style": {
                "H1": null,
                "H2": null
            },
            "maxLength": 100,
            "isCustom": true
        },
        "antwortenAnzahl": {
            "type": "int",
            "isCustom": true
        },
        "generiertAm": {
            "notNull": false,
            "type": "datetime",
            "minuteStep": 30,
            "isCustom": true
        },
        "pdfFile": {
            "type": "file",
            "maxFileSize": 20,
            "accept": [
                "application/pdf"
            ],
            "sourceList": [],
            "tooltip": true,
            "isCustom": true
        },
        "kmi": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "kfi": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "koi": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "kti": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "kki": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "kbi": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "kgi": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "ampelStatus": {
            "type": "enum",
            "options": [
                "grün",
                "gelb",
                "rot"
            ],
            "style": {
                "grün": "success",
                "gelb": "warning",
                "rot": "danger"
            },
            "default": "grün",
            "maxLength": 100,
            "isCustom": true
        },
        "empfaenger": {
            "type": "linkMultiple",
            "view": "views/fields/link-multiple",
            "isCustom": true
        },
        "welleStatus": {
            "type": "enum",
            "options": [
                "neu",
                "versendet",
                "geschlossen",
                "ausgewertet"
            ],
            "style": {
                "neu": null,
                "versendet": "warning",
                "geschlossen": "danger",
                "ausgewertet": "success"
            },
            "default": "neu",
            "maxLength": 100,
            "isCustom": true
        }
    },
    "links": {
        "pdfFile": {
            "type": "belongsTo",
            "entity": "Attachment"
        },
        "empfaenger": {
            "type": "hasMany",
            "relationName": "cMitarbeiterkompassBerichtEmpfaenger",
            "foreign": "cMitarbeiterkompassBerichts",
            "entity": "User",
            "audited": false,
            "isCustom": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    },
    "optimisticConcurrencyControl": false
}