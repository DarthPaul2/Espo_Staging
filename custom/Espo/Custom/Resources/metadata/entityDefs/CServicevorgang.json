{
    "fields": {
        "name": {
            "type": "varchar",
            "readOnly": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "vorgangsart": {
            "type": "enum",
            "options": [
                "service",
                "wartung",
                "notdienst",
                "reklamation",
                "gewaehrleistung"
            ],
            "default": "service",
            "required": true,
            "isCustom": true,
            "tooltip": true,
            "style": {
                "notdienst": "danger",
                "reklamation": "warning"
            }
        },
        "status": {
            "type": "enum",
            "options": [
                "neu",
                "geprueft",
                "geplant",
                "inArbeit",
                "rueckfrageMaterial",
                "abgeschlossen",
                "abrechnungsfaehig"
            ],
            "default": "neu",
            "isCustom": true,
            "tooltip": true,
            "style": {
                "neu": "info",
                "abgeschlossen": "success",
                "abrechnungsfaehig": "success",
                "rueckfrageMaterial": "warning"
            }
        },
        "prioritaet": {
            "type": "enum",
            "options": [
                "kritisch",
                "hoch",
                "normal",
                "planbar"
            ],
            "default": "normal",
            "isCustom": true,
            "tooltip": true,
            "style": {
                "kritisch": "danger",
                "hoch": "warning"
            }
        },
        "dringlichkeitsangabeKunde": {
            "type": "bool",
            "isCustom": true,
            "tooltip": true
        },
        "account": {
            "type": "link",
            "isCustom": true,
            "tooltip": true
        },
        "objekt": {
            "type": "link",
            "isCustom": true,
            "view": "custom:views/c-servicevorgang/fields/objekt"
        },
        "anlageTyp": {
            "type": "enum",
            "options": [
                "",
                "bma",
                "ema",
                "video",
                "zutritt",
                "other"
            ],
            "isCustom": true,
            "tooltip": true
        },
        "problem": {
            "type": "text",
            "required": true,
            "isCustom": true,
            "tooltip": true
        },
        "meldungsart": {
            "type": "enum",
            "options": [
                "",
                "telefon",
                "email",
                "formular",
                "sonstiges"
            ],
            "isCustom": true
        },
        "wartung": {
            "type": "link",
            "isCustom": true,
            "tooltip": true
        },
        "geplanterTermin": {
            "type": "datetime",
            "isCustom": true
        },
        "technikers": {
            "type": "linkMultiple",
            "isCustom": true,
            "tooltip": true
        },
        "anruferName": {
            "type": "varchar",
            "maxLength": 150,
            "isCustom": true
        },
        "anruferTelefon": {
            "type": "varchar",
            "maxLength": 50,
            "isCustom": true
        },
        "alarmierungAm": {
            "type": "datetime",
            "isCustom": true
        },
        "alarmBestaetigtAm": {
            "type": "datetime",
            "isCustom": true
        },
        "alarmEskaliert": {
            "type": "bool",
            "isCustom": true
        },
        "rueckrufAm": {
            "type": "datetime",
            "isCustom": true
        },
        "rueckrufDurch": {
            "type": "link",
            "isCustom": true
        },
        "entscheidung": {
            "type": "enum",
            "options": [
                "",
                "telefonischGeloest",
                "vorOrtEinsatz",
                "eskaliert",
                "fehlalarm"
            ],
            "isCustom": true,
            "tooltip": true,
            "style": {
                "eskaliert": "danger"
            }
        },
        "rueckrufNotiz": {
            "type": "text",
            "isCustom": true,
            "tooltip": true
        },
        "kundensperreErkannt": {
            "type": "bool",
            "isCustom": true
        },
        "kundensperreEntscheidung": {
            "type": "text",
            "isCustom": true,
            "tooltip": true
        },
        "reaktionszeitMinuten": {
            "type": "int",
            "isCustom": true,
            "tooltip": true
        },
        "reaktionszeitManuell": {
            "type": "bool",
            "isCustom": true,
            "layoutListDisabled": true,
            "layoutDetailDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true,
            "importDisabled": true,
            "exportDisabled": true,
            "customizationDisabled": true
        },
        "reklamationSystemisch": {
            "type": "bool",
            "isCustom": true,
            "tooltip": true
        },
        "reklamationUrsache": {
            "type": "text",
            "isCustom": true
        },
        "reklamationMassnahme": {
            "type": "text",
            "isCustom": true
        },
        "reklamationFrist": {
            "type": "date",
            "isCustom": true
        },
        "bezugAuftrag": {
            "type": "link",
            "isCustom": true
        },
        "abnahmeDatum": {
            "type": "date",
            "isCustom": true,
            "tooltip": true
        },
        "berechtigt": {
            "type": "enum",
            "options": [
                "zuPruefen",
                "ja",
                "nein"
            ],
            "default": "zuPruefen",
            "isCustom": true,
            "tooltip": true
        },
        "wartungshinweis": {
            "type": "text",
            "notStorable": true,
            "isCustom": true,
            "view": "custom:views/c-servicevorgang/fields/wartungshinweis",
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true,
            "importDisabled": true,
            "exportDisabled": true,
            "customizationDisabled": true
        },
        "mangelFestgestellt": {
            "type": "bool",
            "isCustom": true,
            "tooltip": true,
            "readOnly": true,
            "view": "custom:views/c-servicevorgang/fields/mangel-festgestellt"
        },
        "mangelBeschreibung": {
            "type": "text",
            "isCustom": true
        },
        "erzeugtesAngebot": {
            "type": "link",
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "account": {
            "type": "belongsTo",
            "entity": "Account",
            "foreign": "cServicevorgaenge",
            "audited": false,
            "isCustom": true
        },
        "objekt": {
            "type": "belongsTo",
            "entity": "CObjekt",
            "foreign": "servicevorgaenge",
            "audited": false,
            "isCustom": true
        },
        "wartung": {
            "type": "belongsTo",
            "entity": "CWartung",
            "foreign": "servicevorgaenge",
            "audited": false,
            "isCustom": true
        },
        "rueckrufDurch": {
            "type": "belongsTo",
            "entity": "User",
            "audited": false,
            "isCustom": true
        },
        "technikers": {
            "type": "hasMany",
            "entity": "User",
            "foreign": "servicevorgaengeAlsTechniker",
            "relationName": "cServicevorgangTechniker",
            "isCustom": true
        },
        "bezugAuftrag": {
            "type": "belongsTo",
            "entity": "CAuftrag",
            "foreign": "servicevorgaenge",
            "audited": false,
            "isCustom": true
        },
        "erzeugtesAngebot": {
            "type": "belongsTo",
            "entity": "CAngebot",
            "audited": false,
            "isCustom": true
        },
        "stundenberichte": {
            "type": "hasMany",
            "foreign": "servicevorgang",
            "entity": "CStundenbericht",
            "audited": false,
            "isCustom": true
        },
        "tasks": {
            "type": "hasMany",
            "foreign": "cServicevorgang",
            "entity": "Task",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}