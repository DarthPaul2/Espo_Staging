{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "freigabeArt": {
            "type": "enum",
            "options": ["Einkauf", "Angebot", "Kulanz", "Rechnung", "Vertrag", "Change"],
            "required": true,
            "isCustom": true,
            "tooltip": true
        },
        "bezugEntitaet": {
            "type": "varchar",
            "maxLength": 50,
            "isCustom": true,
            "tooltip": true
        },
        "bezugId": {
            "type": "varchar",
            "maxLength": 24,
            "isCustom": true,
            "tooltip": true
        },
        "betrag": {
            "type": "float",
            "isCustom": true,
            "tooltip": true
        },
        "budget": {
            "type": "float",
            "isCustom": true,
            "tooltip": true
        },
        "abweichungProzent": {
            "type": "float",
            "isCustom": true,
            "tooltip": true
        },
        "abweichungBetrag": {
            "type": "float",
            "isCustom": true,
            "tooltip": true
        },
        "risikostufe": {
            "type": "enum",
            "options": ["", "GREEN", "YELLOW", "RED"],
            "isCustom": true,
            "tooltip": true,
            "style": {"GREEN": "success", "YELLOW": "warning", "RED": "danger"}
        },
        "risikokategorie": {
            "type": "multiEnum",
            "options": [
                "Haftungs-/Rechts-/Sicherheits-/Reputationsrisiko",
                "Liquiditäts-/Forderungsrisiko mit Unternehmenswirkung",
                "strategischer Key Account / erheblicher Umsatz-/Reputationsfall",
                "ungewöhnliche Vertragsbedingungen / außerhalb normalem Rahmen",
                "wesentliche Personalmaßnahme/Kündigung",
                "Führungskonflikt (auf Bereichsebene nicht lösbar)",
                "kritischer IT-/Datenschutz-/Informationssicherheitsvorfall"
            ],
            "isCustom": true,
            "tooltip": true
        },
        "anfordernbeRolle": {
            "type": "link",
            "isCustom": true,
            "tooltip": true
        },
        "anfordernbeRolleRollencode": {
            "readOnly": true,
            "type": "foreign",
            "link": "anfordernbeRolle",
            "field": "rollencode",
            "view": "views/fields/foreign-varchar",
            "isCustom": true
        },
        "erforderlicheRolle": {
            "type": "link",
            "readOnly": true,
            "isCustom": true,
            "tooltip": true
        },
        "erforderlicheRolleRollencode": {
            "readOnly": true,
            "type": "foreign",
            "link": "erforderlicheRolle",
            "field": "rollencode",
            "view": "views/fields/foreign-varchar",
            "isCustom": true
        },
        "freigeberUser": {
            "type": "link",
            "isCustom": true,
            "tooltip": true
        },
        "status": {
            "type": "enum",
            "options": ["offen", "freigegeben", "abgelehnt", "zurückgestellt"],
            "default": "offen",
            "isCustom": true,
            "tooltip": true,
            "style": {"offen": "warning", "freigegeben": "success", "abgelehnt": "danger", "zurückgestellt": "default"}
        },
        "entscheidungsgrund": {
            "type": "text",
            "isCustom": true,
            "tooltip": true
        },
        "entscheidungAm": {
            "type": "datetime",
            "readOnly": true,
            "isCustom": true,
            "tooltip": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "anfordernbeRolle": {
            "type": "belongsTo",
            "entity": "CRollenkatalog",
            "foreign": "cFreigabenAlsAnfordernbeRolle",
            "isCustom": true
        },
        "erforderlicheRolle": {
            "type": "belongsTo",
            "entity": "CRollenkatalog",
            "foreign": "cFreigabenAlsErforderlicheRolle",
            "isCustom": true
        },
        "freigeberUser": {
            "type": "belongsTo",
            "entity": "User",
            "foreign": "cFreigabenAlsFreigeber",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "bezug": {
            "columns": [
                "bezugEntitaet",
                "bezugId",
                "deleted"
            ]
        },
        "status": {
            "columns": [
                "status",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}