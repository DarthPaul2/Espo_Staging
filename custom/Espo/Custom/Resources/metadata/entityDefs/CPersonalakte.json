{
    "fields": {
        "name": {
            "type": "varchar",
            "pattern": "$noBadCharacters",
            "readOnly": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "user": {
            "type": "link",
            "required": true,
            "duplicateIgnore": true
        },
        "userVollerName": {
            "type": "foreign",
            "link": "user",
            "field": "name",
            "view": "views/fields/foreign-varchar",
            "readOnly": true,
            "isCustom": true
        },
        "userFunktion": {
            "type": "foreign",
            "link": "user",
            "field": "title",
            "view": "views/fields/foreign-varchar",
            "readOnly": true,
            "isCustom": true
        },
        "userEmail": {
            "type": "foreign",
            "link": "user",
            "field": "emailAddress",
            "view": "views/fields/foreign-varchar",
            "readOnly": true,
            "isCustom": true
        },
        "userTelefon": {
            "type": "foreign",
            "link": "user",
            "field": "phoneNumber",
            "view": "views/fields/foreign-varchar",
            "readOnly": true,
            "isCustom": true
        },
        "userIstAktiv": {
            "type": "foreign",
            "link": "user",
            "field": "isActive",
            "view": "views/fields/foreign-bool",
            "readOnly": true,
            "isCustom": true
        },
        "personalnummer": {
            "type": "varchar",
            "isCustom": true
        },
        "eintrittsdatum": {
            "type": "date",
            "audited": true,
            "isCustom": true
        },
        "austrittsdatum": {
            "type": "date",
            "audited": true,
            "isCustom": true
        },
        "beschaeftigungsart": {
            "type": "enum",
            "options": [
                "Vollzeit",
                "Teilzeit",
                "Minijob",
                "Ausbildung",
                "Praktikum",
                "Werkstudent",
                "Sonstige"
            ],
            "audited": true,
            "isCustom": true
        },
        "position": {
            "type": "varchar",
            "audited": true,
            "isCustom": true
        },
        "wochenstunden": {
            "type": "float",
            "audited": true,
            "isCustom": true
        },
        "probezeitBis": {
            "type": "date",
            "audited": true,
            "isCustom": true
        },
        "kuendigungsfrist": {
            "type": "varchar",
            "audited": true,
            "isCustom": true
        },
        "aktuellesBruttogehalt": {
            "type": "float",
            "readOnly": true,
            "audited": true,
            "isCustom": true
        },
        "aktuellerStundenlohn": {
            "type": "float",
            "readOnly": true,
            "isCustom": true
        },
        "datumLetzteGehaltsaenderung": {
            "type": "date",
            "readOnly": true,
            "isCustom": true
        },
        "urlaubsanspruchTage": {
            "type": "int",
            "audited": true,
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "user": {
            "type": "belongsTo",
            "foreign": "cPersonalakte",
            "entity": "User",
            "isCustom": true
        },
        "personalakteGehalts": {
            "type": "hasMany",
            "foreign": "personalakte",
            "entity": "CPersonalakteGehalt",
            "audited": false,
            "isCustom": true
        },
        "personalakteDokuments": {
            "type": "hasMany",
            "foreign": "personalakte",
            "entity": "CPersonalakteDokument",
            "audited": false,
            "isCustom": true
        },
        "personalakteVerlaufs": {
            "type": "hasMany",
            "foreign": "personalakte",
            "entity": "CPersonalakteVerlauf",
            "audited": false,
            "isCustom": true
        },
        "personalakteFrists": {
            "type": "hasMany",
            "foreign": "personalakte",
            "entity": "CPersonalakteFrist",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}