{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "typ": {
            "type": "enum",
            "options": ["Herstellerfreigabe", "Fachkunde", "Schulung", "Sicherheits-Kundenanforderung", "Sonstige"],
            "isCustom": true,
            "tooltip": true
        },
        "aussteller": {
            "type": "varchar",
            "maxLength": 150,
            "isCustom": true,
            "tooltip": true
        },
        "nachweisArt": {
            "type": "enum",
            "options": ["Zertifikat", "Schulungsnachweis", "Bescheinigung", "Sonstige"],
            "isCustom": true,
            "tooltip": true
        },
        "beschreibung": {
            "type": "text",
            "isCustom": true,
            "tooltip": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "cQualifikationszuordnungen": {
            "type": "hasMany",
            "foreign": "qualifikation",
            "entity": "CQualifikationszuordnung",
            "audited": false,
            "isCustom": true
        },
        "cQualifikationsanforderungen": {
            "type": "hasMany",
            "foreign": "qualifikation",
            "entity": "CQualifikationsanforderung",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}