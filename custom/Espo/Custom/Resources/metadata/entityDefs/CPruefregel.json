{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "regelcode": {
            "type": "varchar",
            "maxLength": 50,
            "required": true,
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "prozesscode": {
            "type": "varchar",
            "maxLength": 10,
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "zielEntitaet": {
            "type": "varchar",
            "maxLength": 50,
            "required": true,
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "zielStatus": {
            "type": "varchar",
            "maxLength": 50,
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "statusFeld": {
            "type": "varchar",
            "maxLength": 100,
            "default": "status",
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "kriteriumTyp": {
            "type": "enum",
            "options": ["MUST", "EXTERNAL_MUST", "SHOULD", "INFO"],
            "required": true,
            "isCustom": true,
            "tooltip": true,
            "audited": true,
            "style": {
                "MUST": "danger",
                "EXTERNAL_MUST": "danger",
                "SHOULD": "warning",
                "INFO": "info"
            }
        },
        "teilampel": {
            "type": "enum",
            "options": [
                "technicalReadiness",
                "personnelReadiness",
                "qualificationReadiness",
                "materialReadiness",
                "documentationReadiness",
                "customerReadiness",
                "commercialReadiness",
                "safetyReadiness"
            ],
            "required": true,
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "pruefservice": {
            "type": "enum",
            "options": [
                "checkRequiredFields",
                "checkRoleAssignment",
                "checkSubstitution",
                "checkTechnicianQualification",
                "checkAvailability",
                "checkMaterialReadiness",
                "checkDocumentCompleteness",
                "checkApproval",
                "checkBudget",
                "checkCustomerConfirmation",
                "checkOpenCriticalItems",
                "checkInvoiceReadiness",
                "checkProjectCloseReadiness",
                "checkDataQuality"
            ],
            "required": true,
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "feldOderBeziehung": {
            "type": "varchar",
            "maxLength": 100,
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "operator": {
            "type": "enum",
            "options": ["=", "!=", ">", "<", ">=", "<=", "existiert", "existiertNicht", "enthaltenIn", "nichtEnthaltenIn"],
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "erwarteterWert": {
            "type": "varchar",
            "maxLength": 255,
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "statuswechselBlockieren": {
            "type": "bool",
            "default": true,
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "uebersteuerbar": {
            "type": "bool",
            "default": false,
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "uebersteuerungsRolle": {
            "type": "link",
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "uebersteuerungsRolleRollencode": {
            "readOnly": true,
            "type": "foreign",
            "link": "uebersteuerungsRolle",
            "field": "rollencode",
            "view": "views/fields/foreign-varchar",
            "isCustom": true
        },
        "zustaendigeRolle": {
            "type": "link",
            "required": true,
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "zustaendigeRolleRollencode": {
            "readOnly": true,
            "type": "foreign",
            "link": "zustaendigeRolle",
            "field": "rollencode",
            "view": "views/fields/foreign-varchar",
            "isCustom": true
        },
        "aufgabenVorlage": {
            "type": "text",
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "eskalationsregel": {
            "type": "text",
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "meldungstext": {
            "type": "text",
            "required": true,
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "gueltigVon": {
            "type": "date",
            "required": true,
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "gueltigBis": {
            "type": "date",
            "isCustom": true,
            "tooltip": true,
            "audited": true
        },
        "version": {
            "type": "int",
            "default": 1,
            "readOnly": true,
            "isCustom": true,
            "tooltip": true,
            "audited": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "uebersteuerungsRolle": {
            "type": "belongsTo",
            "entity": "CRollenkatalog",
            "foreign": "cPruefregelnAlsUebersteuerungsRolle",
            "isCustom": true
        },
        "zustaendigeRolle": {
            "type": "belongsTo",
            "entity": "CRollenkatalog",
            "foreign": "cPruefregelnAlsZustaendigeRolle",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "UNIQ_REGELCODE": {
            "unique": true,
            "columns": [
                "regelcode",
                "deleted"
            ]
        },
        "zielEntitaet": {
            "columns": [
                "zielEntitaet",
                "deleted"
            ]
        },
        "zustaendigeRolle": {
            "columns": [
                "zustaendigeRolleId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}