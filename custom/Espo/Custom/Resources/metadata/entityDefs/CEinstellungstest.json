{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "kandidatVorname": {
            "type": "varchar",
            "isCustom": true
        },
        "kandidatNachname": {
            "type": "varchar",
            "isCustom": true
        },
        "kandidatGeburtsjahr": {
            "type": "int",
            "isCustom": true
        },
        "position": {
            "type": "varchar",
            "isCustom": true
        },
        "testStatus": {
            "type": "enum",
            "options": [
                "offen",
                "laeuft",
                "abgeschlossen"
            ],
            "style": {
                "offen": null,
                "laeuft": "warning",
                "abgeschlossen": "success"
            },
            "default": "offen",
            "maxLength": 100,
            "isCustom": true
        },
        "zugangslink": {
            "type": "url",
            "isCustom": true
        },
        "gesamtpunkte": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "bewertung": {
            "type": "enum",
            "options": [
                "sehr_gut",
                "gut",
                "befriedigend",
                "nicht_ausreichend"
            ],
            "style": {
                "sehr_gut": "success",
                "gut": "success",
                "befriedigend": "warning",
                "nicht_ausreichend": "danger"
            },
            "maxLength": 100,
            "isCustom": true
        },
        "punkteAllgemeinbildung": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "punkteWirtschaft": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "punkteMathematik": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "punkteLogischesDenken": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "punkteRaeumlichesDenken": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "punkteTechnischesVerstaendnis": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "gestartetAm": {
            "notNull": false,
            "type": "datetime",
            "minuteStep": 30,
            "isCustom": true
        },
        "abgeschlossenAm": {
            "notNull": false,
            "type": "datetime",
            "minuteStep": 30,
            "isCustom": true
        },
        "tatsaechlicheDauerMinuten": {
            "notNull": false,
            "type": "int",
            "isCustom": true
        },
        "pdfBericht": {
            "type": "file",
            "maxFileSize": 20,
            "accept": [
                "application/pdf"
            ],
            "sourceList": [],
            "tooltip": true,
            "isCustom": true
        }
    },
    "links": {
        "pdfBericht": {
            "type": "belongsTo",
            "entity": "Attachment"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}