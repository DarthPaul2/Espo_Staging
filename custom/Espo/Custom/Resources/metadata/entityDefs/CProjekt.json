{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "auftrag": {
            "type": "link",
            "required": true,
            "isCustom": true,
            "tooltip": true
        },
        "projektleitung": {
            "type": "link",
            "required": false,
            "isCustom": true,
            "tooltip": true
        },
        "budgetGeplant": {
            "type": "float",
            "isCustom": true,
            "tooltip": true
        },
        "budgetIst": {
            "type": "float",
            "isCustom": true,
            "tooltip": true
        },
        "stundenGeplant": {
            "type": "float",
            "isCustom": true,
            "tooltip": true
        },
        "stundenIst": {
            "type": "float",
            "isCustom": true,
            "tooltip": true
        },
        "risiken": {
            "type": "text",
            "isCustom": true
        },
        "einsatzTermin": {
            "type": "date",
            "isCustom": true,
            "tooltip": true
        },
        "terminBestaetigt": {
            "type": "bool",
            "isCustom": true,
            "tooltip": true
        },
        "technischeAuftragspruefungOk": {
            "type": "bool",
            "isCustom": true,
            "tooltip": true
        },
        "technikerVerfuegbar": {
            "type": "enum",
            "options": ["", "ja", "nein"],
            "readOnly": true,
            "isCustom": true,
            "tooltip": true
        },
        "technikerQualifikationStatus": {
            "type": "enum",
            "options": ["", "GUELTIG", "LAEUFT_BALD_AB", "ABGELAUFEN", "FEHLT"],
            "readOnly": true,
            "isCustom": true,
            "tooltip": true
        },
        "materialVerfuegbarkeitProzent": {
            "type": "float",
            "isCustom": true,
            "tooltip": true
        },
        "revisionsplanAktuell": {
            "type": "bool",
            "isCustom": true,
            "tooltip": true
        },
        "kundenzugangBestaetigt": {
            "type": "bool",
            "isCustom": true,
            "tooltip": true
        },
        "status": {
            "type": "enum",
            "options": ["", "in_vorbereitung", "einsatzbereit"],
            "default": "in_vorbereitung",
            "isCustom": true,
            "tooltip": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "auftrag": {
            "type": "belongsTo",
            "entity": "CAuftrag",
            "foreign": "projekte",
            "isCustom": true
        },
        "projektleitung": {
            "type": "belongsTo",
            "entity": "User",
            "foreign": "projekteAlsProjektleitung",
            "isCustom": true
        },
        "projektteamzuordnungen": {
            "type": "hasMany",
            "entity": "CProjektteamzuordnung",
            "foreign": "projekt",
            "isCustom": true
        },
        "meilensteine": {
            "type": "hasMany",
            "entity": "CMeilenstein",
            "foreign": "projekt",
            "isCustom": true
        },
        "qualifikationsanforderungen": {
            "type": "hasMany",
            "entity": "CQualifikationsanforderung",
            "foreign": "projekt",
            "isCustom": true
        },
        "ampelstatuses": {
            "type": "hasMany",
            "entity": "CAmpelStatus",
            "foreign": "projekt",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "auftrag": {
            "columns": [
                "auftragId",
                "deleted"
            ]
        },
        "projektleitung": {
            "columns": [
                "projektleitungId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}