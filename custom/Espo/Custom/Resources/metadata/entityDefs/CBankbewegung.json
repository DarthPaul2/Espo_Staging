{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "pattern": "$noBadCharacters",
            "options": []
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "buchungstag": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "valutadatum": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "betrag": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "richtung": {
            "type": "enum",
            "options": [
                "eingang",
                "ausgang"
            ],
            "style": {
                "eingang": null,
                "ausgang": null
            },
            "default": "eingang",
            "maxLength": 100,
            "isCustom": true
        },
        "waehrung": {
            "type": "enum",
            "options": [
                "eur"
            ],
            "style": {
                "eur": null
            },
            "default": "eur",
            "maxLength": 100,
            "isCustom": true
        },
        "gegenparteiName": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "gegenparteiIban": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "verwendungszweck": {
            "type": "text",
            "rowsMin": 2,
            "cutHeight": 200,
            "isCustom": true
        },
        "bankReferenz": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "endToEndId": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "mandatsreferenz": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "importHash": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "importQuelle": {
            "type": "enum",
            "options": [
                "csv",
                "camt",
                "manual",
                "api"
            ],
            "style": {
                "csv": null,
                "camt": null,
                "manual": null,
                "api": null
            },
            "default": "manual",
            "maxLength": 100,
            "isCustom": true
        },
        "importiertAm": {
            "notNull": false,
            "type": "datetime",
            "minuteStep": 30,
            "isCustom": true
        },
        "status": {
            "type": "enum",
            "options": [
                "importiert",
                "automatisch_erkannt",
                "manuell_zugeordnet",
                "unklar",
                "ignoriert"
            ],
            "style": {
                "importiert": null,
                "automatisch_erkannt": null,
                "manuell_zugeordnet": null,
                "unklar": null,
                "ignoriert": null
            },
            "default": "importiert",
            "maxLength": 100,
            "isCustom": true
        },
        "abstimmungsstatus": {
            "type": "enum",
            "options": [
                "offen",
                "vorschlag",
                "zugeordnet",
                "teilweise_zugeordnet",
                "gebucht",
                "nicht_relevant"
            ],
            "style": {
                "offen": "primary",
                "vorschlag": "info",
                "zugeordnet": "warning",
                "teilweise_zugeordnet": "warning",
                "gebucht": "success",
                "nicht_relevant": "danger"
            },
            "default": "offen",
            "maxLength": 100,
            "isCustom": true,
            "displayAsLabel": true
        },
        "erkannteBelegnummer": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "erkannteGegenpartei": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "zuordnungsHinweis": {
            "type": "text",
            "rowsMin": 2,
            "cutHeight": 200,
            "isCustom": true
        },
        "bemerkung": {
            "type": "text",
            "rowsMin": 2,
            "cutHeight": 200,
            "isCustom": true
        },
        "bankkonto": {
            "type": "link"
        },
        "zahlung": {
            "type": "link"
        },
        "rechnung": {
            "type": "link"
        },
        "eingangsrechnung": {
            "type": "link"
        },
        "account": {
            "type": "link"
        },
        "lieferant": {
            "type": "link"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "bankkonto": {
            "type": "belongsTo",
            "foreign": "bankbewegungen",
            "entity": "CBankkonto",
            "audited": false,
            "isCustom": true
        },
        "zahlung": {
            "type": "belongsTo",
            "foreign": "bankbewegungen",
            "entity": "CZahlung",
            "audited": false,
            "isCustom": true
        },
        "rechnung": {
            "type": "belongsTo",
            "foreign": "bankbewegungen",
            "entity": "CRechnung",
            "audited": false,
            "isCustom": true
        },
        "eingangsrechnung": {
            "type": "belongsTo",
            "foreign": "bankbewegungen",
            "entity": "CEingangsrechnung",
            "audited": false,
            "isCustom": true
        },
        "account": {
            "type": "belongsTo",
            "foreign": "cBankbewegungen",
            "entity": "Account",
            "audited": false,
            "isCustom": true
        },
        "lieferant": {
            "type": "belongsTo",
            "foreign": "bankbewegungen",
            "entity": "CLieferant",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    },
    "optimisticConcurrencyControl": false
}